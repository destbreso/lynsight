{
  "name": "lynsight",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Lynis audit reporter with LLM-powered insights (Ollama/OpenAI/Anthropic). Web UI + CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:cli": "pnpm --filter @lynsight/cli dev",
    "dev:web": "pnpm --filter @lynsight/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "cli": "pnpm --filter @lynsight/cli start --"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
